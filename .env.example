# ── HuggingFace ─────────────────────────────────────────────────────────────
# Required: MedGemma is a gated model. Accept terms at:
# https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=hf_your_token_here

# ── Kaggle (for dataset download) ────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── LLM API Keys (for QA dataset generation) ─────────────────────────────────
# At least one of these is needed for generate_qa_dataset.py
ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_key_here

# ── Paths ────────────────────────────────────────────────────────────────────
MIMIC_CXR_PATH=./data/mimic-cxr
PROCESSED_DATA_PATH=./data/processed
INDEX_PATH=./data/index
RESULTS_PATH=./results
CHECKPOINTS_PATH=./checkpoints

# ── Model Configuration ───────────────────────────────────────────────────────
MEDGEMMA_MODEL_ID=google/medgemma-4b-it
COLPALI_MODEL_ID=vidore/colpali-v1.2
BIOMEDCLIP_MODEL_ID=hf-hub:microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "true" to use 4-bit quantization (reduces VRAM requirement to ~5GB)
USE_4BIT=false
# Set to "true" to run without loading real models (unit testing / CI)
MOCK_MODELS=false
# Device: "cuda", "mps", "cpu"
DEVICE=cuda
